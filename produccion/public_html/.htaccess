# Sitio AVM en Dongee (Apache)
DirectoryIndex index.php index.html
Options -Indexes

# Siempre por HTTPS
RewriteEngine On
RewriteCond %{HTTPS} off
RewriteCond %{HTTP_HOST} !^(localhost|127\.0\.0\.1)(:\d+)?$
RewriteCond %{HTTP:X-Forwarded-Proto} !https
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# Direcciones limpias para Google y para compartir
RewriteRule ^(destino|hotel|actividad)/([A-Za-z0-9_~-]+)/?$ index.php?ruta=$1&id=$2 [L,QSA]
RewriteRule ^(agencias|traslados|privacidad)/?$ index.php?ruta=$1 [L,QSA]
RewriteRule ^sitemap\.xml$ sitemap.php [L]
RewriteRule ^robots\.txt$ robots.php [L]

# Archivos que no se deben poder descargar
<FilesMatch "(^\.|\.(json|lock|log|md|sql|bak)$|^_.*\.php$)">
  Require all denied
</FilesMatch>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  <FilesMatch "\.(webp|png|jpg|svg|woff2)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
  <FilesMatch "\.(html|js)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
